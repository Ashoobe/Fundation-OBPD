<!-- Contact Page -->
<section class="section">
  <div class="container contact-container">
    <div class="contact-intro">
      <h1 class="section-title">Contact Us</h1>
      <p>We'd love to hear from you! Whether you have questions, want to get involved, or would like to make a donation, please reach out.</p>
    </div>

    <% if params[:success] %>
      <div class="alert alert-success">
        Thank you for your message! We'll get back to you soon.
      </div>
    <% end %>

    <% if @error %>
      <div class="alert alert-error">
        <%= @error %>
      </div>
    <% end %>

    <div class="contact-form">
      <h2>Send Us a Message</h2>
      <form method="POST" action="/contact" data-validate>
        <div class="form-group">
          <label for="name" class="form-label">Name *</label>
          <input type="text" id="name" name="name" class="form-input" required>
        </div>

        <div class="form-group">
          <label for="email" class="form-label">Email *</label>
          <input type="email" id="email" name="email" class="form-input" required>
        </div>

        <div class="form-group">
          <label for="message" class="form-label">Message *</label>
          <textarea id="message" name="message" class="form-textarea" required></textarea>
        </div>

        <button type="submit" class="btn">Send Message</button>
      </form>
    </div>

    <div class="contact-info">
      <div class="contact-card">
        <div class="contact-icon">📧</div>
        <h3>Email</h3>
        <p>info@obpdfoundation.org</p>
      </div>

      <div class="contact-card">
        <div class="contact-icon">📞</div>
        <h3>Phone</h3>
        <p>(630) 555-1234</p>
      </div>

      <div class="contact-card">
        <div class="contact-icon">📍</div>
        <h3>Address</h3>
        <p>1450 Forest Gate Road<br>Oak Brook, IL 60523</p>
      </div>
    </div>
  </div>
</section>
